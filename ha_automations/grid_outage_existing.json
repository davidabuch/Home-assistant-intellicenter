{
  "id": "1791567921134",
  "alias": "Grid Outage - Pool Safety Supervisor",
  "description": "Qualified-outage safety: retain Spa/accessory/light shutdown and heating OFF, then request the single RPM Guardian. No Pool ON/OFF command, legacy runtime RPM setter or removed Grid Outage feature. Native priming/freeze/flow authority preempts speed enforcement. The existing detector retains five-minute qualification and two-minute restoration.",
  "triggers": [
    {
      "trigger": "time_pattern",
      "minutes": "/1"
    },
    {
      "trigger": "state",
      "entity_id": "input_boolean.grid_outage_active"
    },
    {
      "trigger": "time",
      "at": "09:00:00"
    },
    {
      "trigger": "time",
      "at": "17:00:00"
    }
  ],
  "conditions": [
    {
      "condition": "state",
      "entity_id": "input_boolean.grid_outage_active",
      "state": "on"
    },
    {
      "condition": "state",
      "entity_id": "input_boolean.grid_outage_protection",
      "state": "on"
    },
    {
      "condition": "state",
      "entity_id": "input_boolean.grid_outage_operator_bypass_latch",
      "state": "off"
    }
  ],
  "actions": [
    {
      "if": [
        {
          "condition": "state",
          "entity_id": "climate.hot_tub_thermostat",
          "state": "heat"
        }
      ],
      "then": [
        {
          "action": "climate.set_hvac_mode",
          "target": {
            "entity_id": "climate.hot_tub_thermostat"
          },
          "data": {
            "hvac_mode": "off"
          }
        }
      ]
    },
    {
      "repeat": {
        "for_each": [
          "switch.water_slide",
          "switch.jets_bubbles",
          "switch.spillway"
        ],
        "sequence": [
          {
            "if": [
              {
                "condition": "template",
                "value_template": "{{ is_state(repeat.item, 'on') }}"
              }
            ],
            "then": [
              {
                "action": "switch.turn_off",
                "target": {
                  "entity_id": "{{ repeat.item }}"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "if": [
        {
          "condition": "state",
          "entity_id": "light.pool_light",
          "state": "on"
        }
      ],
      "then": [
        {
          "action": "light.turn_off",
          "target": {
            "entity_id": "light.pool_light"
          }
        }
      ]
    },
    {
      "if": [
        {
          "condition": "not",
          "conditions": [
            {
              "condition": "state",
              "entity_id": "select.pool_heat_source",
              "state": "Off"
            }
          ]
        }
      ],
      "then": [
        {
          "action": "select.select_option",
          "target": {
            "entity_id": "select.pool_heat_source"
          },
          "data": {
            "option": "Off"
          }
        }
      ]
    },
    {
      "if": [
        {
          "condition": "state",
          "entity_id": "climate.hot_tub_thermostat",
          "state": "off"
        }
      ],
      "then": [
        {
          "action": "select.select_option",
          "target": {
            "entity_id": "select.hot_tub_heat_source"
          },
          "data": {
            "option": "Off"
          }
        }
      ]
    },
    {
      "action": "intellicenter_manual.reconcile_pump_speeds",
      "data": {
        "entry_id": "01M4F1DFGA4AH4F9E9M7MJCR5Q",
        "reason": "qualified_outage_safety"
      }
    }
  ],
  "mode": "restart"
}
