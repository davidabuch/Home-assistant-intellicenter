{
  "id": "1792102863523",
  "alias": "IntelliCenter RPM Guardian - Reconciliation",
  "description": "Event-driven ordinary anti-drift; minute heartbeat services durable pending work and safety recovery only. Startup scan waits for fresh initialization. Single guarded writer; no equipment ON/OFF decisions. Active Solar delivery transition also triggers RPM reconciliation; minute heartbeat retains existing manual RPM protections.",
  "triggers": [
    {
      "trigger": "time",
      "at": "23:59:00",
      "id": "before_filtration"
    },
    {
      "trigger": "time",
      "at": "08:00:00",
      "id": "accounting_rollover"
    },
    {
      "trigger": "time_pattern",
      "minutes": "/1",
      "id": "recovery_heartbeat"
    },
    {
      "trigger": "homeassistant",
      "event": "start",
      "id": "startup"
    },
    {
      "trigger": "state",
      "entity_id": [
        "input_boolean.grid_outage_active",
        "input_boolean.grid_outage_protection",
        "input_boolean.grid_outage_operator_bypass_latch",
        "input_boolean.grid_outage_simulation",
        "input_boolean.grid_outage_use_real_sensor",
        "binary_sensor.1_powerwall_grid_status"
      ],
      "id": "grid_policy"
    },
    {
      "trigger": "state",
      "entity_id": "climate.hot_tub_thermostat",
      "to": "heat",
      "id": "spa_session"
    },
    {
      "trigger": "state",
      "entity_id": [
        "input_boolean.pool_sanitation_session",
        "input_boolean.spa_sanitation_session"
      ],
      "to": "on",
      "id": "sanitation_request"
    },
    {
      "trigger": "state",
      "entity_id": "binary_sensor.solar_heating_active",
      "to": "on",
      "id": "solar_delivery_started"
    }
  ],
  "conditions": [],
  "actions": [
    {
      "action": "intellicenter_manual.reconcile_pump_speeds",
      "data": {
        "entry_id": "01M4F1DFGA4AH4F9E9M7MJCR5Q",
        "reason": "{{ trigger.id | default('manual', true) }}"
      }
    }
  ],
  "mode": "queued",
  "max": 3
}
